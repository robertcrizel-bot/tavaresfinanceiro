# EXAMPLE ONLY. Frontend defaults off; do not copy secrets into VITE_*.
VITE_ASAAS_SANDBOX_ENABLED=false

# Edge Function secrets, only in a SEPARATE test Supabase project.
ASAAS_SANDBOX_ENABLED=false
ASAAS_SANDBOX_SUPABASE_URL=https://REPLACE_WITH_ISOLATED_TEST_PROJECT.supabase.co
ASAAS_SANDBOX_APP_ORIGIN=https://REPLACE_WITH_TEST_PREVIEW_HOST
ASAAS_SANDBOX_API_KEY=SET_A_SANDBOX_KEY_IN_THE_SECRET_STORE
ASAAS_SANDBOX_WEBHOOK_TOKEN=SET_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ASAAS_SANDBOX_WORKER_TOKEN=SET_ANOTHER_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the isolated
# Supabase Edge runtime. Never expose the service role key to the browser.
