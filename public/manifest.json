{
  "name": "FinVision",
  "short_name": "FinVision",
  "description": "Gerencie suas finanças pessoais com simplicidade e clareza.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0c1220",
  "theme_color": "#10b981",
  "orientation": "portrait-primary",
  "share_target": {
    "action": "/receipt-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "receipt",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/finvision-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192-v2.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
